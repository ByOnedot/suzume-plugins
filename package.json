{
  "name": "suzume-plugins",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:webpack-react": "yarn workspace example-webpack-react dev",
    "build": "yarn workspaces foreach -A --include \"*@byonedot/*\" run build",
    "check:branding": "node ./scripts/check-branding.js",
    "check:links": "node ./scripts/check-links.js"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "suzume",
    "suzume-design",
    "webpack",
    "vite",
    "plugin"
  ],
  "author": "Suzume Design",
  "license": "MIT",
  "devDependencies": {
    "@types/babel__core": "^7.20.0",
    "@typescript-eslint/eslint-plugin": "^5.4.0",
    "@typescript-eslint/parser": "^5.4.0",
    "eslint": "^7.2.0",
    "eslint-config-airbnb-base": "^14.2.0",
    "eslint-config-prettier": "^6.15.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-prettier": "^3.1.4",
    "husky": "^4.3.0",
    "lerna": "^3.22.1",
    "lint-staged": "^10.5.0",
    "prettier": "^2.1.2",
    "typescript": "^5.0.4"
  },
  "homepage": "https://byonedot.in",
  "repository": {
    "type": "git",
    "url": "https://github.com/ByOnedot/suzume-plugins.git"
